{
  "name": "django-material",
  "version": "0.1.0",
  "description": "Material Design for Django",
  "scripts": {
    "build:css": "tailwindcss -i material/assets/index.css -i material/templates -o material/static/material/css/material.css --minify",
    "watch:css": "tailwindcss -i material/assets/index.css -o material/static/material/css/material.css --watch",
    "dev": "npm run watch:css",
    "update:fonts": "npx get-google-fonts --input=\"https://fonts.googleapis.com/css?family=Roboto:100,300,400,500,700,900&display=swap\" --output=\"material/static/material/fonts/roboto/\" && npx get-google-fonts --input=\"https://fonts.googleapis.com/icon?family=Material+Icons\" --output=\"material/static/material/fonts/material-icons/\""
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.14",
    "tailwindcss": "^4.0.14"
  }
}
